# Environment variables for CLOUVENT
# Copy this file to .env.local and fill in values.
# NEVER commit .env.local to the repository.

# ── Contact form (Resend) ──────────────────────────────────────────────────────
# Sign up at https://resend.com — free tier is sufficient for low volume.
# Create an API key in your Resend dashboard.
RESEND_API_KEY=

# The verified email address that will RECEIVE enquiry submissions.
# Must be verified in your Resend account.
CONTACT_TO_EMAIL=clouventsolutions@gmail.com

# The "from" address shown to enquirers when they receive an acknowledgement.
# Must be from a domain verified in Resend (e.g. hello@yourclouventdomain.com).
# Until a production domain is set up, Resend allows sending from
# onboarding@resend.dev in development — useful for testing.
CONTACT_FROM_EMAIL=onboarding@resend.dev
